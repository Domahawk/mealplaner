{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "starter/laravel-vue-pwa",
    "type": "project",
    "description": "A Laravel API and Vue 3 PWA starter.",
    "keywords": [
        "laravel",
        "vue",
        "pwa",
        "starter"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "@php artisan test",
        "lint": "@format:check",
        "format": "pint",
        "format:check": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M --no-progress",
        "quality": [
            "@format:check",
            "@analyse"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
