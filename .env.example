APP_NAME=Mealplaner
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=starter
DB_USERNAME=starter
# Local development only. Set a unique password before sharing an environment.
DB_PASSWORD=local-development-password
DB_SSLMODE=prefer

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
VITE_PWA_SHORT_NAME="My App"
# Browser-visible hostname, never a Docker service name.
VITE_HMR_HOST=localhost
VITE_PORT=5173
VITE_USE_POLLING=true
VITE_POLL_INTERVAL=300

# Set these to the output of id -u and id -g if different.
LOCAL_UID=1000
LOCAL_GID=1000
APP_PORT=8000
